generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvoiceStatus {
  Draft
  Sent
  PartiallyPaid
  Paid
  Overdue
  Cancelled
}

enum ProjectStatus {
  Enquiry
  QuotationSent
  Approved
  InProduction
  PostProduction
  Delivered
  Completed
  Cancelled
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("owner")
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  passwordResetSentAt    DateTime?
  invoices     Invoice[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CompanyProfile {
  id              String   @id @default("company")
  name            String
  tagline         String
  address         String
  phone           String
  email           String
  website         String
  gstNumber       String?
  panNumber       String?
  bankDetails     String?
  bankAccountName String?
  bankName        String?
  bankAccountNumber String?
  bankBranch      String?
  bankIfsc        String?
  upiDetails      String?
  paymentTerms    String
  invoiceNotes    String
  quotationTerms  String
  logoData        String?  @db.Text
  faviconData     String?  @db.Text
  legacySettingsMigrated Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NotificationSettings {
  id                          String   @id @default("notifications")
  smtpHost                    String?
  smtpPort                    Int      @default(587)
  smtpSecure                  Boolean  @default(false)
  smtpUsername                String?
  smtpPasswordEncrypted       String?  @db.Text
  smtpFromEmail               String?
  smtpFromName                String?
  discordWebhookEncrypted     String?  @db.Text
  notifyInvoices              Boolean  @default(true)
  notifyQuotations            Boolean  @default(true)
  notifyPayments               Boolean  @default(true)
  updatedAt                   DateTime @updatedAt
}

model Client {
  id                String    @id
  name              String
  contactPerson     String
  email             String
  phone             String
  billingAddress    String
  currency          String    @default("INR")
  gst               String
  paymentTerms      String
  notes             String
  outstandingBalance Int       @default(0)
  projects          Project[]
  invoices          Invoice[]
  payments          Payment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Vendor {
  id        String   @id
  name      String
  email     String
  phone     String
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id               String         @id
  quotationNumber String?         @unique
  name             String
  clientId         String
  description      String
  startDate        DateTime
  shootDate        DateTime
  deliveryDate     DateTime
  quotationAmount  Int
  invoiceAmount    Int
  paymentsReceived Int
  projectExpenses  Int
  status           ProjectStatus
  billingStatus    InvoiceStatus
  notes            String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientId])
  @@index([shootDate])
}

model Invoice {
  id          String        @id
  number      String        @unique
  ownerId     String
  clientId    String
  projectId   String?
  invoiceDate DateTime
  dueDate     DateTime
  status      InvoiceStatus
  subtotal    Int
  discount    Int
  tax         Int
  total       Int
  paid        Int
  outstanding Int
  notes       String
  owner       User          @relation(fields: [ownerId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       InvoiceItem[]
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId, invoiceDate])
  @@index([ownerId])
  @@index([projectId])
  @@index([invoiceDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  rate        Int
  discount    Int
  tax         Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String   @id
  invoiceId String
  clientId  String
  projectId String?
  amount    Int
  date      DateTime
  method    String
  reference String
  notes     String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([date])
  @@index([invoiceId])
  @@index([projectId])
}

model Expense {
  id        String    @id
  date      DateTime
  category  String
  vendor    String
  amount    Int
  projectId String?
  method    String
  reference String
  notes     String
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([date])
  @@index([projectId])
}
